NEXT_PUBLIC_SITE_URL=https://deevs.kz

# Необязательно. Подтверждение прав в Google Search Console и Яндекс Вебмастере через meta-тег
# (только значение content, без кавычек). Если подтверждаете через DNS у регистратора — не нужно.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Необязательно. Счётчики аналитики: номер счётчика Яндекс Метрики и ID потока GA4 (G-XXXXXXX).
# Цели для Метрики описаны в lib/analytics.ts.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
